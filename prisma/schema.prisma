generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  FIDELITY_TAXABLE
  VZ_SAVINGS_401K
  VZ_LEGACY_401K
  VZ_EDP
}

enum InstrumentType {
  STOCK
  FUND
  CASH
}

enum ImportBatchStatus {
  PENDING
  COMPLETE
  PARTIAL
  FAILED
}

enum BenchmarkScope {
  ACCOUNT
  AGGREGATE_TOTAL
  AGGREGATE_ACTIONABLE
}

enum AgentType {
  RELATIVE_STRENGTH
  SECTOR_ROTATION
  RISK_MANAGER
  CANDIDATE_SCANNER
  UNIVERSE_REFRESH
  EARNINGS_ESTIMATES_REFRESH
}

enum AgentRunStatus {
  RUNNING
  COMPLETE
  FAILED
}

model Account {
  id               String            @id @default(cuid())
  name             String
  type             AccountType
  institution      String
  /// External account identifier from the source institution's export (e.g. Fidelity's masked account number), used to match repeat imports to the right account.
  externalId       String?           @unique
  isLocked         Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  holdings         Holding[]
  importBatches    ImportBatch[]
  benchmarkResults BenchmarkResult[]
  actionItems      ActionItem[]
  performances     AccountPerformance[]
  planFundMenuEntries PlanFundMenuEntry[]
}

model Instrument {
  id           String         @id @default(cuid())
  symbol       String         @unique
  name         String?
  type         InstrumentType @default(STOCK)
  expenseRatio Float?
  category     String?
  holdings     Holding[]
}

model ImportBatch {
  id               String            @id @default(cuid())
  account          Account           @relation(fields: [accountId], references: [id])
  accountId        String
  source           String
  fileName         String
  asOfDate         DateTime
  uploadedAt       DateTime          @default(now())
  status           ImportBatchStatus @default(PENDING)
  errorMessage     String?
  rowCount         Int               @default(0)
  holdings         Holding[]
  benchmarkResults BenchmarkResult[]
  planFundMenuEntries PlanFundMenuEntry[]

  @@index([accountId, asOfDate])
}

/// A single Fidelity-reported rolling-period return for one account, as
/// extracted from the weekly Performance PDF, alongside the S&P 500 return
/// for the same period so alpha can be read directly off this row instead of
/// recomputed from price history. One row per (accountId, period, asOfDate);
/// a re-upload for the same as-of date replaces the prior row for that period.
model AccountPerformance {
  id             String   @id @default(cuid())
  account        Account? @relation(fields: [accountId], references: [id])
  /// Null for the "Total Portfolio" aggregate row extracted from the Performance PDF's Total line — see isAggregate.
  accountId      String?
  /// True for the Total-row aggregate entry (accountId is null in that case). Postgres doesn't dedupe NULL accountId rows against the (accountId, period, asOfDate) unique index, so the aggregate row is upserted by application-level find-then-write instead — see performance-pdf/confirm/route.ts.
  isAggregate    Boolean  @default(false)
  /// "1m" | "3m" | "ytd" | "1y" | "3y" | "5y" | "life"
  period         String
  returnPct      Float
  sp500ReturnPct Float?
  alpha          Float?
  /// Only set when period is "life" — the start date Fidelity used for the account's life-of-data return.
  startDate      DateTime?
  asOfDate       DateTime
  createdAt      DateTime @default(now())

  @@unique([accountId, period, asOfDate])
  @@index([accountId, period])
  @@index([isAggregate, period])
}

model Holding {
  id               String      @id @default(cuid())
  account          Account     @relation(fields: [accountId], references: [id])
  accountId        String
  instrument       Instrument  @relation(fields: [instrumentId], references: [id])
  instrumentId     String
  importBatch      ImportBatch @relation(fields: [importBatchId], references: [id])
  importBatchId    String
  asOfDate         DateTime
  quantity         Float
  lastPrice        Float?
  currentValue     Float
  costBasisTotal   Float?
  averageCostBasis Float?
  percentOfAccount Float?
  /// Year-to-date return as a decimal fraction (e.g. 0.1046 for +10.46%), captured from a screenshot's balance overview when shown. Null when the source didn't report it.
  ytdReturn        Float?

  @@index([accountId, asOfDate])
  @@index([instrumentId])
}

/// One row per fund in a 401k plan's complete "Investment Choices" menu, as
/// extracted from the plan's Fidelity fund-menu PDF — the authoritative,
/// complete list of every fund the plan offers (typically 20-30 entries),
/// not just the ones currently held. Scoped to a single plan via accountId
/// (each Verizon plan — Savings, Mid-Atlantic — is its own Account), so two
/// plans' same-named funds (e.g. both informally called "Small Cap Eqty
/// Indx") can never collide: they're simply two rows under two different
/// accountIds. isHeld mirrors the PDF's checkmark column and is independent
/// of whether a Holding row exists for this fund (a fund can be in the menu
/// without ever having been imported as a position). A re-upload of the same
/// plan's menu upserts by (accountId, fundName) rather than duplicating.
model PlanFundMenuEntry {
  id            String       @id @default(cuid())
  account       Account      @relation(fields: [accountId], references: [id])
  accountId     String
  fundName      String
  assetClass    String?
  /// Public ticker, only populated when the fund has one (most proprietary institutional 401k funds don't) — see fundMappings.ts's plan-scoped disambiguation, which prefers ticker over name when both plans have a same-named fund.
  ticker        String?
  oneYear       Float?
  threeYear     Float?
  fiveYear      Float?
  tenYear       Float?
  inceptionDate DateTime?
  isHeld        Boolean      @default(false)
  asOfDate      DateTime
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id])
  importBatchId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([accountId, fundName])
  @@index([accountId])
}

/// Cached daily S&P 500 (^GSPC) closing prices, so benchmark math doesn't hit
/// Yahoo Finance on every request.
model BenchmarkPrice {
  id    String   @id @default(cuid())
  date  DateTime @unique
  close Float
}

/// A single computed portfolio-vs-S&P-500 comparison for one account or one
/// aggregate scope, over one rolling period, tied to the ImportBatch whose
/// snapshot supplied the "as of" end value.
model BenchmarkResult {
  id                  String         @id @default(cuid())
  importBatch         ImportBatch    @relation(fields: [importBatchId], references: [id])
  importBatchId       String
  scope               BenchmarkScope
  account             Account?       @relation(fields: [accountId], references: [id])
  accountId           String?
  /// "1y" | "3y" | "5y"
  period              String
  asOfDate            DateTime
  requestedStartDate  DateTime
  actualStartDate     DateTime?
  startValue          Float?
  endValue            Float?
  portfolioReturn     Float?
  sp500Return         Float?
  alpha               Float?
  insufficientHistory Boolean        @default(false)
  createdAt           DateTime       @default(now())

  @@index([scope, period, asOfDate])
  @@index([accountId, period])
}

/// One execution of a portfolio-analysis agent (e.g. Relative Strength),
/// storing its full structured output alongside the run's lifecycle state.
model AgentRun {
  id          String         @id @default(cuid())
  agentType   AgentType
  status      AgentRunStatus @default(RUNNING)
  startedAt   DateTime       @default(now())
  completedAt DateTime?
  output      Json?
  errorMessage String?
  actionItems ActionItem[]
  candidateRecommendationLogs CandidateRecommendationLog[]

  @@index([agentType, startedAt])
}

/// A single recommended action surfaced by an agent run, optionally rolled
/// up into a WeeklyBrief for the CIO summary view.
model ActionItem {
  id             String       @id @default(cuid())
  agentRun       AgentRun     @relation(fields: [agentRunId], references: [id])
  agentRunId     String
  priority       Int
  action         String
  rationale      String
  expectedImpact String?
  account        Account?     @relation(fields: [accountId], references: [id])
  accountId      String?
  weeklyBrief    WeeklyBrief? @relation(fields: [weeklyBriefId], references: [id])
  weeklyBriefId  String?
  createdAt      DateTime     @default(now())

  @@index([agentRunId])
  @@index([weeklyBriefId])
}

/// The CIO's weekly synthesized brief across all agent runs — one row per
/// week, linking the action items chosen for that week's summary.
model WeeklyBrief {
  id          String       @id @default(cuid())
  weekOf      DateTime     @unique
  cioSummary  String
  /// The CIO's taxable-account trim/sector-gap/momentum-add analysis for this week, shaped like CioTaxableOpportunities in lib/agents/cio.ts. Null when no taxable account data was available at synthesis time.
  taxableOpportunities Json?
  /// Qualitative "News & Sentiment Watch" notes for this week's Top Candidates, shaped like NewsSentimentNote[] in lib/agents/newsSentiment.ts. Context only — never fed into the composite score or ranking. Null when no ANTHROPIC_API_KEY was configured or no Candidate Scanner run was available at synthesis time.
  newsSentimentNotes Json?
  actionItems ActionItem[]
  recommendationOutcomes RecommendationOutcome[]
  createdAt   DateTime     @default(now())
}

/// Tracks what actually happened after a CIO recommendation was made — the
/// track record foundation for Phase 4 productization. Keyed by
/// (weeklyBriefId, actionItemIndex) rather than the ActionItem's own id,
/// since synthesizeWeeklyBrief() deletes and recreates that week's
/// ActionItem rows (and their ids) every time it resynthesizes; the index
/// within a given brief is the stable reference.
model RecommendationOutcome {
  id              String       @id @default(cuid())
  weeklyBrief     WeeklyBrief  @relation(fields: [weeklyBriefId], references: [id])
  weeklyBriefId   String
  /// 1-based position of the recommendation within that week's action item list (matches ActionItem.priority).
  actionItemIndex Int
  executed        Boolean      @default(false)
  executedDate    DateTime?
  /// Relative performance (symbol return minus S&P 500 return, decimal fraction) 30/90 days after executedDate. Null until enough time has elapsed, or when no ticker could be identified from the recommendation text.
  outcome30d      Float?
  outcome90d      Float?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([weeklyBriefId, actionItemIndex])
}

/// A persistent snapshot of one Candidate Scanner "Top Candidates" entry at
/// the time it was surfaced, tracked unconditionally (unlike
/// RecommendationOutcome, which only tracks CIO recommendations a human
/// confirmed executing). Every successful CANDIDATE_SCANNER AgentRun logs one
/// row per top candidate here (see logCandidateRecommendationBatch in
/// lib/agents/candidateRecommendationLog.ts), tagged with batchTag so
/// successive weekly refreshes are chronologically distinguishable and
/// comparable — e.g. to see whether last week's top pick actually
/// outperformed over the following 30/90 days.
model CandidateRecommendationLog {
  id                 String   @id @default(cuid())
  sourceAgentRun     AgentRun @relation(fields: [sourceAgentRunId], references: [id])
  sourceAgentRunId   String
  /// Groups the rows produced by one scan into a comparable batch — routine automatic batches use "top15-YYYY-MM-DD" (the scan date); see notes for batches with special provenance (e.g. this table's first batch, logged after the SPDR-derived universe expansion).
  batchTag           String
  symbol             String
  sector             String
  accountType        String
  /// 0-100 composite score at the time of recommendation.
  score              Int
  /// This symbol's own return minus the S&P 500's return over the same window, in percentage points, at the time of recommendation.
  vsSpx              Float
  /// Blended multi-horizon momentum (decimal fraction) at the time of recommendation — see MomentumBlend.raw in technicals.ts. Null if unavailable.
  momentum1Y         Float?
  recommendationType String
  recommendedAt      DateTime
  /// Relative performance (symbol return minus S&P 500 return, decimal fraction) 30/90 days after recommendedAt. Null until enough time has elapsed.
  outcome30d         Float?
  outcome90d         Float?
  notes              String?
  createdAt          DateTime @default(now())

  @@index([batchTag])
  @@index([symbol, recommendedAt])
}

/// The current data-driven candidate universe for one sector, refreshed
/// monthly from official SPDR sector fund holdings (see
/// lib/agents/sectorHoldings.ts + lib/agents/candidateUniverse.ts) — replaces
/// the hand-picked hardcoded list that used to live in candidateScanner.ts for
/// sectors covered by this refresh. Sectors not yet migrated keep using a
/// static list directly in candidateScanner.ts.
model CandidateUniverse {
  id        String   @id @default(cuid())
  sector    String   @unique
  sectorEtf String
  /// Top-weighted constituent tickers as of the last refresh (string[]).
  symbols   Json
  asOf      DateTime
  updatedAt DateTime @updatedAt
}

/// The current cached Alpha Vantage EARNINGS_ESTIMATES read for one symbol
/// from the candidate universe, refreshed on a rolling weekly cadence (~12
/// symbols/day, see app/api/cron/earnings-estimates/route.ts) rather than all
/// at once, since the free tier caps at 25 calls/day. One row per symbol,
/// upserted in place — this is the current snapshot, not a history of past
/// pulls. All eps/revision fields are nullable and left null rather than
/// coerced to 0 whenever Alpha Vantage itself reports "None" or omits a
/// field for that horizon; hasEstimates distinguishes that from the other
/// null-shaped case, an empty `estimates` array (symbol has no analyst
/// coverage at all) — see hasEstimates doc below. Values reflect Alpha
/// Vantage's nearest ("current quarter") horizon row; confirm this is the
/// intended horizon before the first live pull.
model EarningsEstimateSnapshot {
  id        String @id @default(cuid())
  symbol    String @unique

  /// eps_estimate_average, and the same figure as Alpha Vantage reported it 7/30/60/90 days before the current pull. Null means Alpha Vantage didn't report a value for that horizon (not a real zero).
  epsEstimateAverageCurrent   Float?
  epsEstimateAverage7DaysAgo  Float?
  epsEstimateAverage30DaysAgo Float?
  epsEstimateAverage60DaysAgo Float?
  epsEstimateAverage90DaysAgo Float?

  /// eps_estimate_revision_up/down_trailing_7/30_days — analyst revision counts. Null means not reported; a real 0 (no revisions either direction) is stored as 0.
  revisionUpTrailing7Days     Int?
  revisionDownTrailing7Days   Int?
  revisionUpTrailing30Days    Int?
  revisionDownTrailing30Days  Int?

  /// True when the last successful fetch returned a non-empty `estimates` array for this symbol (the eps/revision fields above reflect real, if partial, coverage). False when the last successful fetch confirmed Alpha Vantage has no analyst coverage at all for this symbol (estimates array was empty) — distinct from never having been fetched, which is lastFetchedAt == null regardless of this flag's default.
  hasEstimates    Boolean   @default(false)
  /// Set only when a fetch for this symbol completed successfully — the signal the daily cron uses to decide which symbols are stale/not-yet-pulled this week (see selectSymbolsToFetch in lib/agents/earningsEstimates.ts). Left as-is on a failed attempt, so a transient error doesn't make a symbol look freshly fetched.
  lastFetchedAt   DateTime?
  /// Set on every fetch attempt, success or failure — lets the cron tell "never tried" (both timestamps null) apart from "tried today but failed" (lastAttemptedAt today, lastFetchedAt stale) so it doesn't re-attempt a failing symbol multiple times in the same day's batch.
  lastAttemptedAt DateTime?
  /// Cleared on the next successful fetch; populated on failure for debugging (rate limit, malformed response, symbol not found, etc.).
  lastErrorMessage String?

  updatedAt DateTime @updatedAt

  @@index([lastFetchedAt])
}

/// Per-symbol fetch-cycle bookkeeping for the earnings-history pipeline (see
/// lib/agents/earningsHistory.ts) — the EARNINGS-endpoint analog of
/// EarningsEstimateSnapshot's tracking fields above, kept as its own model
/// since EarningsHistory below is many-rows-per-symbol (one per fiscal
/// quarter) rather than a single current snapshot.
model EarningsFetchState {
  id     String @id @default(cuid())
  symbol String @unique

  /// True when the last successful fetch returned a non-empty `quarterlyEarnings` array for this symbol. False means Alpha Vantage's EARNINGS endpoint has no history at all — distinct from never having been fetched (lastFetchedAt == null).
  hasHistory Boolean @default(false)
  /// Set only when a fetch for this symbol completed successfully — the signal the daily cron uses to decide which symbols are stale this week (see selectSymbolsToFetch in lib/agents/earningsHistory.ts).
  lastFetchedAt DateTime?
  /// Set on every fetch attempt, success or failure.
  lastAttemptedAt DateTime?
  /// Cleared on the next successful fetch; populated on failure for debugging.
  lastErrorMessage String?

  updatedAt DateTime @updatedAt

  @@index([lastFetchedAt])
}

/// One row per reported/estimated fiscal quarter from Alpha Vantage's EARNINGS
/// endpoint (quarterlyEarnings array), for the symbols in EarningsFetchState.
/// Powers the earnings-surprise-trend factor (see lib/agents/earningsSurpriseTrend.ts),
/// which needs several quarters of reportedEPS-vs-estimatedEPS history per
/// symbol to compute a standardized unexpected earnings (SUE) score — unlike
/// EarningsEstimateSnapshot's single-row current-snapshot shape, this is
/// intentionally a time series. Only the most recent QUARTERS_TO_PERSIST
/// quarters returned by Alpha Vantage are kept (some symbols return 100+
/// quarters of history; far more than the scoring window needs).
model EarningsHistory {
  id     String @id @default(cuid())
  symbol String

  /// The fiscal period this quarter's figures cover.
  fiscalDateEnding DateTime
  /// The date Alpha Vantage recorded this quarter as reported. Can be a future/recent date with reportedEPS still null — Alpha Vantage often lists the upcoming quarter before backfilling its actual reported figure, a normal reporting lag rather than missing data.
  reportedDate DateTime?
  /// Null when this quarter hasn't been reported yet (see reportedDate above) or Alpha Vantage didn't report a value — distinct from a real 0.
  reportedEPS Float?
  estimatedEPS Float?
  /// Alpha Vantage's own reportedEPS - estimatedEPS, kept for reference; the SUE calculation recomputes this from reportedEPS/estimatedEPS directly rather than trusting this field, so a null here doesn't block scoring as long as both underlying fields are present.
  surprise Float?
  surprisePercentage Float?

  updatedAt DateTime @updatedAt

  @@unique([symbol, fiscalDateEnding])
  @@index([symbol])
}

/// A tiny key-value store for cross-cutting notification state that doesn't
/// belong to any one domain row — e.g. the last time a Pushover push actually
/// went out, so a same-day re-run of the agent pipeline (multiple imports in
/// one day, a manual "Run Now") doesn't page the phone again.
model NotificationState {
  id         String   @id @default(cuid())
  key        String   @unique
  lastSentAt DateTime
}
